{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Setup: Environment Check",
      "type": "shell",
      "command": "python3 ${workspaceFolder}/py/setup_check.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$python"
      ]
    },
    {
      "label": "Deploy: Build Static Bundle",
      "type": "shell",
      "command": "npm run build:deploy",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "npm_config_cache": "${workspaceFolder}/.npm-cache"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Deploy: Preview (Wrangler)",
      "type": "shell",
      "command": "npm run preview",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "npm_config_cache": "${workspaceFolder}/.npm-cache",
          "WRANGLER_LOG_PATH": "${workspaceFolder}/.wrangler/logs",
          "WRANGLER_WRITE_LOGS": "false",
          "XDG_CONFIG_HOME": "${workspaceFolder}/.config",
          "XDG_CACHE_HOME": "${workspaceFolder}/.cache"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Deploy: Cloudflare Workers",
      "type": "shell",
      "command": "npm run deploy",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "npm_config_cache": "${workspaceFolder}/.npm-cache",
          "WRANGLER_LOG_PATH": "${workspaceFolder}/.wrangler/logs",
          "WRANGLER_WRITE_LOGS": "false",
          "XDG_CONFIG_HOME": "${workspaceFolder}/.config",
          "XDG_CACHE_HOME": "${workspaceFolder}/.cache"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "UI Tests: Install Dependencies",
      "type": "shell",
      "command": "npm install && npm run test:ui:install",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "npm_config_cache": "${workspaceFolder}/.npm-cache"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "UI Tests: Local Static Server",
      "type": "shell",
      "command": "python3 ${workspaceFolder}/scripts/run_static_server.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "UI Tests: Smoke (Headless)",
      "type": "shell",
      "command": "npm run test:ui",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "npm_config_cache": "${workspaceFolder}/.npm-cache"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "UI Tests: Smoke (Headed)",
      "type": "shell",
      "command": "npm run test:ui:headed",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "npm_config_cache": "${workspaceFolder}/.npm-cache"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Pharm: Import DrugBank TSV",
      "type": "shell",
      "command": "python3 ${workspaceFolder}/pharm/scripts/import_drugbank_tsv.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$python"
      ]
    },
    {
      "label": "Pharm: Expand DrugBank Catalog",
      "type": "shell",
      "command": "python3 ${workspaceFolder}/pharm/scripts/expand_drugbank_catalog.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$python"
      ]
    },
    {
      "label": "Pharm: Build Class Subclasses",
      "type": "shell",
      "command": "python3 ${workspaceFolder}/pharm/scripts/build_class_subclasses.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$python"
      ]
    },
    {
      "label": "Pharm: Build RxClass Catalog",
      "type": "shell",
      "command": "python3 ${workspaceFolder}/pharm/scripts/build_rxclass_medication_catalog.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$python"
      ]
    },
    {
      "label": "Pharm: Compile Main Class Hierarchy",
      "type": "shell",
      "command": "python3 ${workspaceFolder}/pharm/scripts/compile_main_hierarchy.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$python"
      ]
    },
    {
      "label": "Pharm: Build Main Class Mapping",
      "type": "shell",
      "command": "python3 ${workspaceFolder}/pharm/scripts/build_main_class_mapping.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$python"
      ]
    },
    {
      "label": "Pharm: Audit Clinical Fields",
      "type": "shell",
      "command": "python3 ${workspaceFolder}/pharm/scripts/audit_clinical_fields.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$python"
      ]
    },
    {
      "label": "Pharm: Full Pharm Rebuild",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Pharm: Build RxClass Catalog",
        "Pharm: Compile Main Class Hierarchy",
        "Pharm: Build Main Class Mapping"
      ],
      "problemMatcher": []
    },
    {
      "label": "Pharm: Smoke Tests",
      "type": "shell",
      "command": "npx playwright test tests/smoke/pharm.spec.js",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Calculators: Smoke Tests",
      "type": "shell",
      "command": "npx playwright test tests/smoke/calculators.spec.js",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Writer: Smoke Tests",
      "type": "shell",
      "command": "npx playwright test tests/smoke/notewriter.spec.js",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Writer: Build Tabs Manifest",
      "type": "shell",
      "command": "python3 ${workspaceFolder}/py/make_tab_manifest.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$python"
      ]
    },
    {
      "label": "Differentials: Fill Clinical Todo From PDF",
      "type": "shell",
      "command": "python3 ${workspaceFolder}/differentials/fill_clinical_todo_from_pdf.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$python"
      ]
    },
    {
      "label": "Differentials: Write Presentation",
      "type": "shell",
      "command": "python3 ${workspaceFolder}/differentials/write_presentation.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$python"
      ]
    },
    {
      "label": "Differentials: Fix Parenthetical Etiologies",
      "type": "shell",
      "command": "python3 ${workspaceFolder}/differentials/fix_parenthetical_etiologies.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$python"
      ]
    },
    {
      "label": "Daily Run: Quick Smoke",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Setup: Environment Check",
        "Pharm: Smoke Tests"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Daily Run: Full Rebuild + Smoke",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Setup: Environment Check",
        "Pharm: Full Pharm Rebuild",
        "Pharm: Smoke Tests"
      ],
      "group": {
        "kind": "build"
      },
      "problemMatcher": []
    }
  ]
}
